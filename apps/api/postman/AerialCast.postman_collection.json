{
  "info": {
    "_postman_id": "c8e8f6a9-5e39-4c63-a7d1-9d1b8d7c1234",
    "name": "AerialCast API (MVP)",
    "description": "Collection to exercise the AerialCast API and realtime Socket.IO flows for the MVP demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Register/login users and capture JWT bearer tokens.",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with the seeded ADMIN account. The access token is stored as `adminToken` for subsequent requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.access_token) {",
                  "    pm.environment.set('adminToken', body.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Pilot Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pilotEmailComputed}}\",\n  \"password\": \"{{pilotPassword}}\",\n  \"full_name\": \"Pilot Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a pilot user if it does not already exist. The prerequest script reuses `pilotEmail` from the environment or generates a unique alias."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let email = pm.environment.get('pilotEmail');",
                  "if (!email || !email.trim()) {",
                  "  email = `pilot+${Date.now()}@example.com`;",
                  "  pm.environment.set('pilotEmail', email);",
                  "}",
                  "pm.variables.set('pilotEmailComputed', email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pilot Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pilotEmailComputed}}\",\n  \"password\": \"{{pilotPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login using the pilot credentials and capture the access token as `pilotToken`."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let email = pm.environment.get('pilotEmail');",
                  "if (!email || !email.trim()) {",
                  "  throw new Error('Set pilotEmail or run \"Pilot Register\" first.');",
                  "}",
                  "pm.variables.set('pilotEmailComputed', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.access_token) {",
                  "    pm.environment.set('pilotToken', body.access_token);",
                  "  }",
                  "}",
                  "pm.test('Pilot token was stored', function () {",
                  "  pm.expect(pm.environment.get('pilotToken')).to.be.ok;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
