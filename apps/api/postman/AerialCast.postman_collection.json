      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{adminToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "List Geofences",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/geofences/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "geofences", ""]
            }
          }
        },
        {
          "name": "Create Geofence",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"area_name\": \"Campus NFZ\",\n  \"type\": \"NO_FLY_ZONE\",\n  \"points\": [\n    {\"latitude\": -6.2001, \"longitude\": 106.7991, \"order\": 1},\n    {\"latitude\": -6.2005, \"longitude\": 106.8002, \"order\": 2},\n    {\"latitude\": -6.2010, \"longitude\": 106.7996, \"order\": 3}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/geofences/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "geofences", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.geofence_id) {",
                  "    pm.environment.set('geofence_id', body.geofence_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Geofence",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"area_name\": \"Campus Safe Zone\",\n  \"type\": \"SAFE_ZONE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/geofences/{{geofence_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "geofences", "{{geofence_id}}"]
            }
          }
        },
        {
          "name": "Delete Geofence",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/geofences/{{geofence_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "geofences", "{{geofence_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "WebSocket Telemetry",
      "description": "Manual Socket.IO testing via Postman's WebSocket client. Use after obtaining the desired JWT token and session id.",
      "item": [
        {
          "name": "Connect (Pilot Token)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{wsBase}}/socket.io/?EIO=4&transport=websocket&token={{pilotToken}}",
              "host": ["{{wsBase}}"],
              "path": ["socket.io", ""],
              "query": [
                { "key": "EIO", "value": "4" },
                { "key": "transport", "value": "websocket" },
                { "key": "token", "value": "{{pilotToken}}" }
              ]
            },
            "description": "Opens a Socket.IO connection authenticated with the pilot token. After the initial handshake you can send Engine.IO packets manually. To subscribe to a session room, send `42[\"join_session\",{\"session_id\":\"{{session_id}}\"}]`. To leave, use `42[\"leave_session\",{\"session_id\":\"{{session_id}}\"}]`. Expect broadcast events such as `telemetry_update`, `session_started`, and `session_ended` scoped to the joined session."
          },
          "protocolProfileBehavior": {
            "websocket": {
              "pingInterval": 25000
            }
          }
        },
        {
          "name": "Connect (Admin Token)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{wsBase}}/socket.io/?EIO=4&transport=websocket&token={{adminToken}}",
              "host": ["{{wsBase}}"],
              "path": ["socket.io", ""],
              "query": [
                { "key": "EIO", "value": "4" },
                { "key": "transport", "value": "websocket" },
                { "key": "token", "value": "{{adminToken}}" }
              ]
            },
            "description": "Same as the pilot connection but authenticated with the admin token. Useful when verifying admin-specific mission status broadcasts."
          }
        }
      ]
    }
  ]
}
