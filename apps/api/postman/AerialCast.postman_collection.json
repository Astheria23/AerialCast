      "item": [
        {
          "name": "List Drones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/drones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "drones", ""]
            },
            "description": "Retrieve all registered drones. Public endpoint but included here for convenience."
          }
        },
        {
          "name": "Create Drone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Drone\",\n  \"model\": \"QuadX\",\n  \"lora_id\": \"DRONE-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/drones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "drones", ""]
            },
            "description": "Create a drone and persist its identifiers for downstream flows."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.drone_id) {",
                  "    pm.environment.set('drone_id', body.drone_id);",
                  "  }",
                  "  if (body && body.lora_id) {",
                  "    pm.environment.set('lora_id', body.lora_id);",
                  "  }",
                  "}",
                  "pm.test('Drone id captured', function () {",
                  "  pm.expect(pm.environment.get('drone_id')).to.be.ok;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Drone",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/drones/{{drone_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "drones", "{{drone_id}}"]
            }
          }
        },
