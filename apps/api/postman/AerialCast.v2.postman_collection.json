              "raw": "{\n  \"email\": \"{{pilotEmailComputed}}\",\n  \"password\": \"{{pilotPassword}}\",\n  \"full_name\": \"Pilot Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let pe = pm.environment.get('pilotEmail'); if (!pe || !pe.trim()) { pe = `pilot+${Date.now()}@example.com`; } pm.variables.set('pilotEmailComputed', pe);"
                ]
              }
            }
          ]
        },
